# =============================================================
# BOT EXNESS · XAUUSD + US STOCKS
# Copy file nay thanh .env roi dien gia tri. Bot doc dung 6 bien duoi.
# =============================================================

# --- BAT BUOC: Telegram ---------------------------------------
# Token lay tu @BotFather. CHAT_ID la ID chat rieng cua ban voi bot;
# bot chi tra loi dung chat nay, moi chat khac bi bo qua.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Exness MetaTrader 5 --------------------------------------
# BAT BUOC: phai cai MetaTrader 5 tren may Windows. Package Python
# "MetaTrader5" chi la cau noi noi bo (IPC) toi terminal64.exe dang chay tren
# CUNG may — no khong tu ket noi toi server Exness. Khong terminal = khong gia.
# Tai tai: https://www.exness.com  (hoac ban MetaQuotes goc cung dung duoc)
#
# CHON 1 TRONG 2 CACH:
#
# CACH A — tu dong hoan toan (nen dung cho bot chay 24/5):
#   Dien ca 4 dong duoi. Bot TU khoi dong terminal va TU dang nhap.
#
# CACH B — gan vao terminal co san:
#   De trong ca 4 dong, tu mo MT5 va dang nhap truoc khi chay bot.

# Duong dan terminal. Bat buoc cho CACH A.
# Vi du: C:\Program Files\MetaTrader 5\terminal64.exe
EXNESS_MT5_PATH=

# Tai khoan Exness (demo hoac that). Bat buoc cho CACH A.
# SERVER lay dung ten trong terminal, vi du: Exness-MT5Trial9
# Bot kiem tra chuoi "exness" trong server/company cua TAI KHOAN, khong phai
# cua terminal — nen ban MetaQuotes goc van dung duoc voi tai khoan Exness.
EXNESS_MT5_LOGIN=
EXNESS_MT5_PASSWORD=
EXNESS_MT5_SERVER=
